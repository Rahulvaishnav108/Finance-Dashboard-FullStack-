          "name": "Revenue Analytics By Day",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Revenue Analytics By Day returns 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json().data;",
                  "pm.expect(data.summary).to.eql({ totalRevenue: 445, totalTax: 45, totalDiscount: 15, billCount: 3, averageBillValue: 148.33 });",
                  "pm.expect(data.filters).to.eql({ from: '2026-01-01', to: '2026-01-31', groupBy: 'day' });",
                  "pm.expect(data.revenue).to.eql([{ period: '2026-01-05', totalRevenue: 95, totalTax: 10, totalDiscount: 5, billCount: 1 }, { period: '2026-01-12', totalRevenue: 350, totalTax: 35, totalDiscount: 10, billCount: 2 }]);",
                  "pm.expect(data.paymentReport).to.eql([{ paymentMethod: 'CARD', count: 1, totalAmount: 200 }, { paymentMethod: 'CASH', count: 1, totalAmount: 150 }, { paymentMethod: 'UPI', count: 1, totalAmount: 95 }]);"
                ]
