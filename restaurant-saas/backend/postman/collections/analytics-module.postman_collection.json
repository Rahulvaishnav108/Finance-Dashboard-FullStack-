      "name": "Auth And Context",
      "item": [
        {
          "name": "Login Analytics Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login Analytics Admin returns 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.success).to.eql(true);",
                  "pm.expect(json.data.accessToken).to.be.a('string');",
                  "pm.environment.set('adminAccessToken', json.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{analyticsAdminEmail}}\",\n  \"password\": \"{{analyticsAdminPassword}}\",\n  \"deviceLabel\": \"Analytics Postman Admin\"\n}"
